#!/usr/bin/env bash
#
# Wrapper that points the vendored rqm.sh at this repository's layout.
#
# Since the src-layout move these values match rqm.sh's own defaults, so this
# wrapper is now mostly a convenience: it also cd's to the repository root, so
# `tools/rqm/rq index` works from any subdirectory rather than silently scanning
# nothing. Keep invoking through it rather than calling rqm.sh directly.
#
# Requires bash >= 4.0 (rqm.sh uses associative arrays). macOS ships bash 3.2 as
# /bin/bash, so the `env bash` shebang matters -- install a modern bash with
# `brew install bash` if this fails with "declare: -A: invalid option".
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

export RQM_DIR="rqm"
export SRC_DIR="src"
export TESTS_DIR="tests"

exec "${REPO_ROOT}/tools/rqm/rqm.sh" "$@"

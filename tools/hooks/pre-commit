#!/usr/bin/env bash
#
# Pre-commit gate: lint + the fast test tier + requirements traceability.
#
# This replaces a gate that did not work. The previous arrangement was a
# PreToolUse hook in .claude/settings.json, which had three problems:
#
#   1. It only ran for commits made through Claude Code. A `git commit` typed
#      in a terminal never touched it.
#   2. Its timeout was 600s against a suite that takes ~1350s, so it could not
#      have passed even when it did run.
#   3. Observed 2026-07-28: it did not fire at all.
#
# A real git hook fixes (1). Running only the fast tier fixes (2): the 12
# end-to-end regression tests marked `slow` account for ~70% of suite runtime
# and belong in CI, not in front of every commit. A gate people wait 22 minutes
# for is a gate people bypass with --no-verify.
#
# Install with:  bash tools/hooks/install.sh
# Bypass with:   git commit --no-verify   (CI still runs the full suite)
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

fail=0
note() { printf '\n\033[1m%s\033[0m\n' "$*"; }
bad()  { printf '\033[31m%s\033[0m\n' "$*"; fail=1; }

# Prefer the project's conda env; fall back to whatever python is on PATH so the
# hook degrades to a warning rather than blocking work in an unusual shell.
PY="${BIOCHAR_PYTHON:-/opt/miniconda3/envs/biochar/bin/python}"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PY" ]; then
  printf '\033[33mpre-commit: no python found; skipping tests.\033[0m\n'
  printf '\033[33m  Set BIOCHAR_PYTHON to your env interpreter to enable this gate.\033[0m\n'
  exit 0
fi

# Gate the tree being committed, which is not always the tree that is installed.
#
# The src layout normally keeps a run honest: `biochar` imports only when
# installed, so a test run cannot quietly pick up the working tree. A git
# worktree breaks that guarantee in the other direction. `pip install -e` points
# the interpreter at whichever tree ran it, and every worktree shares one
# interpreter, so committing from the second worktree runs its tests against the
# first worktree's source. Observed 2026-08-03: a commit was blocked by a test
# that passes, because the gate was reading another checkout's data file.
#
# The failure that matters is the mirror image of that one -- the same mismatch
# with the trees the other way round reports a pass, and a pass about code that
# is not being committed is worse than no gate at all.
#
# So the resolution is checked rather than assumed. If the interpreter already
# lands inside this tree, nothing changes and the installed-package discipline
# is untouched. If it lands anywhere else, this tree's src/ goes in front of it
# and the redirection is announced, because a gate quietly changing what it
# gates is the whole problem being fixed.
REPO_REAL="$(cd "$REPO_ROOT" && pwd -P)"
biochar_home() {
  "$PY" -c 'import biochar, os; print(os.path.realpath(biochar.__file__))' 2>/dev/null
}

RESOLVED="$(biochar_home)"
case "$RESOLVED" in
  "$REPO_REAL"/*) ;;
  *)
    export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
    RESOLVED="$(biochar_home)"
    case "$RESOLVED" in
      "$REPO_REAL"/*)
        printf '\033[33mpre-commit: gating this worktree via PYTHONPATH.\033[0m\n'
        printf '\033[33m  The installed biochar is elsewhere; %s is what gets tested.\033[0m\n' \
          "$REPO_ROOT/src"
        ;;
    esac
    ;;
esac

if [ -z "$RESOLVED" ]; then
  printf '\033[33mpre-commit: no python with biochar importable; skipping tests.\033[0m\n'
  printf '\033[33m  Set BIOCHAR_PYTHON to your env interpreter to enable this gate.\033[0m\n'
  exit 0
fi

# The gate needs more than an importable package: it runs ruff and pytest
# through this interpreter. `import biochar` used to double as a check that this
# was the project env, and stopped being one the moment PYTHONPATH could supply
# the package -- a system python now sails past it and fails `-m ruff`, which
# this script cannot tell from a real finding and reports as a blocked commit.
# That confusion predates the PYTHONPATH change (any env with biochar but
# without the dev extras hit it); it is just newly reachable. Ask for the tools
# by name instead, and skip rather than block when they are absent, which is
# what the guard above was already for.
MISSING=""
for mod in ruff pytest; do
  "$PY" -c "import $mod" >/dev/null 2>&1 || MISSING="$MISSING $mod"
done
if [ -n "$MISSING" ]; then
  printf '\033[33mpre-commit: %s cannot run this gate (no:%s); skipping tests.\033[0m\n' \
    "$PY" "$MISSING"
  printf '\033[33m  Set BIOCHAR_PYTHON to an env with the dev extras: pip install -e ".[dev]"\033[0m\n'
  exit 0
fi

note "pre-commit: secrets"
if ! bash tools/hooks/check-secrets.sh; then
  bad "  blocked: possible secret in staged changes"
fi

note "pre-commit: ruff"
if "$PY" -m ruff check . >/dev/null 2>&1; then
  echo "  clean"
else
  "$PY" -m ruff check . 2>&1 | tail -20
  bad "  blocked: ruff findings above"
fi

# -n auto matters here. Serial, this tier is 5m39s and would get bypassed;
# parallel it is ~24s. Falls back to serial if xdist is missing rather than
# erroring out on a machine that has not installed the dev extras.
note "pre-commit: fast tests (pytest -m 'not slow')"
if "$PY" -c "import xdist" >/dev/null 2>&1; then
  PYTEST_PARALLEL=(-n auto)
else
  PYTEST_PARALLEL=()
  printf '\033[33m  pytest-xdist not installed; running serially (slow)\033[0m\n'
fi
if out=$("$PY" -m pytest -m "not slow" -q -x --no-header "${PYTEST_PARALLEL[@]}" 2>&1); then
  echo "$out" | tail -3
else
  echo "$out" | tail -25
  bad "  blocked: fast-tier tests failed"
fi

# Traceability is advisory here: an unreferenced requirement is a coverage gap
# to close, not a reason to block an unrelated commit. A duplicate ID is
# different -- it silently merges two requirements into one registry entry --
# so `index` failing does block.
note "pre-commit: requirements traceability"
if command -v jq >/dev/null 2>&1; then
  if bash tools/rqm/rq index >/dev/null 2>&1; then
    if ! git diff --quiet rqm/registry.json 2>/dev/null; then
      printf '\033[33m  rqm/registry.json is stale -- run: bash tools/rqm/rq index\033[0m\n'
    else
      echo "  registry current"
    fi
  else
    bad "  blocked: rq index failed (duplicate requirement ID?)"
  fi
else
  printf '\033[33m  jq not installed; skipping traceability check\033[0m\n'
fi

if [ "$fail" -ne 0 ]; then
  printf '\n\033[31mCommit blocked.\033[0m Fix the above, or bypass with: git commit --no-verify\n'
  exit 1
fi
printf '\n\033[32mpre-commit: all checks passed\033[0m\n'

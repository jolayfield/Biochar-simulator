{
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Edit"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rm -r*)",
      "Bash(rmdir *)",
      "Bash(sudo rm*)",
      "Bash(shred *)",
      "Bash(truncate *)"
    ],
    "deny": [
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)"
    ]
  }
}
